// forge.light (Ch.21 §21.8). Contract: text >= 4.5:1, UI boundaries >= 3:1 (WCAG 2.1 AA).
(
    name: "forge.light",
    text_contrast_floor: 4.5,
    ui_contrast_floor: 3.0,
    colors: {
        "bg.base": "#f5f6f8",
        "bg.raised": "#ffffff",
        "bg.sunken": "#eceef1",
        "bg.hover": "#e6e8ec",
        "bg.pressed": "#d9dce1",
        "fg.primary": "#1d1f23",
        "fg.muted": "#555a64",
        "fg.on_accent": "#ffffff",
        "fg.on_danger": "#ffffff",
        "accent": "#2f5fc4",
        "accent.hover": "#2753b0",
        "accent.pressed": "#1f4796",
        "danger": "#b42828",
        "danger.hover": "#9c2020",
        "warning": "#9a6700",
        "success": "#1a7f37",
        "focus.ring": "#1f5fd6",
        "selection": "#cfe0fc",
        "border": "#80858f",
        "scrim": "#00000099",
    },
    space: [2.0, 4.0, 8.0, 12.0, 16.0, 24.0],
    radius: (sm: 3.0, md: 5.0, lg: 8.0),
    border_width: 1.0,
    focus_ring_width: 2.0,
    type_scale: (small: 12.0, body: 14.0, heading: 18.0, mono: 13.0),
    shadows: [
        (offset_x: 0.0, offset_y: 1.0, blur: 2.0, spread: 0.0, color: "#0000001f"),
        (offset_x: 0.0, offset_y: 3.0, blur: 8.0, spread: 0.0, color: "#00000029"),
        (offset_x: 0.0, offset_y: 8.0, blur: 24.0, spread: 0.0, color: "#00000033"),
    ],
    motion: (fast_ms: 90, normal_ms: 160, slow_ms: 240),
)
