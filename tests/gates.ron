        (id: "C-plugin-index-backend", name: "the-plugin-manager-browses-the-signed-plugin-index", state: Unbuilt(reason: "D-4: the plugin manager browses and adds through the PluginIndex trait; the labelled in-memory MemoryIndex (forge_editor::connect::plugins) publishes sample plugins with real WASM code, and fetch, sandbox check, cache and the forge.plugin.add command are real. The signed index (Ch.38 §38.3) is M5-14, not built")),
        (id: "C-remote-transport-backend", name: "remote-connect-pairs-and-lists-sessions-over-forge-remote", state: Bound(file: "crates/forge-remote/tests/test_remote_panel_quic.rs", control: "positive_control_a_host_that_skips_the_code_check_fails")),
        (id: "C-compute-farm-backend", name: "compute-and-farm-shows-forge-jobs-throughput-and-forge-farm-nodes", state: Unbuilt(reason: "D-4: the compute panel reads the ComputePool trait; the labelled in-memory MemoryComputePool lists the adapter pool's adapters (the binary fills them from forge_gpu::AdapterPool) with throughput and farm nodes a producer reports. The heterogeneous job scheduler (forge-jobs, M6-1) and the LAN farm daemon (forge-farm, M6-3) are not built")),
