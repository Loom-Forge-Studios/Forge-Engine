        (id: "C-authoring-panels-idle", name: "an-idle-editor-with-the-authoring-panels-open-draws-and-wakes-nothing", state: Bound(file: "plugins/forge-panels-authoring/tests/test_authoring_panels_idle.rs", control: "positive_control_a_timeline_that_animates_while_stopped_fails")),
