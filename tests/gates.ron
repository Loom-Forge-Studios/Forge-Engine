        (id: "C-wasm-hot-reload", name: "changed-wasm-code-runs-under-the-installed-items-a-broken-save-keeps-the-old", state: Bound(file: "crates/forge-wasm/tests/test_wasm_hot_reload.rs", control: "positive_control_without_a_poll_the_old_code_answers")),
        (id: "C-source-plugin-hot-reload", name: "a-source-plugin-reloads-in-a-running-editor", state: Unbuilt(reason: "Ch.32.3 names a dev dylib for source-plugin hot reload; a dylib loader needs unsafe FFI across Rust's unstable ABI, the failure mode Ch.32.3 rejects for drop-in plugins. Source plugins reload by an incremental rebuild and restart; live drop-in reload is the WASM host's (C-wasm-hot-reload). ADR 0033")),
        (id: "S10", name: "wasm-plugin-overhead-spike", state: Unbuilt(reason: "resolved at M4-15 against a generator node and a PCG rule, and forge-pcg does not exist yet. Early numbers (crates/forge-wasm/tests/test_s10_call_overhead.rs, release, dev box): an empty call 228 ns, a call with one host import 500 ns, a 4096-sample generator-node kernel 14.1 us in WASM vs 4.8 us native (2.96x, fuel metering on), bit-identical output; ADR 0033")),
        (id: "C-security-commands-human-only", name: "security-commands-are-human-only-and-undo-never-grants", state: Bound(file: "crates/forge-editor/tests/test_security_commands.rs", control: "positive_control_security_commands_registered_as_ordinary_fail")),
