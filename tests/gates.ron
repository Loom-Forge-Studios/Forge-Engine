        (id: "C-trace-viewers", name: "traces-open-in-perfetto-and-tracy", state: Awaiting(reason: "opening a forge --headless --trace file in ui.perfetto.dev or trace_processor, and connecting a Tracy viewer to a `tracy` build, need an operator with those GUI tools; the trace is checked structurally by forge-trace's own decoder (C-perfetto-trace-well-formed), and `cargo test -p forge-trace --features tracy` was green on the dev box 2026-09-22 (WP-13)")),
        (id: "C-replay-bit-exact", name: "a-recorded-play-session-replays-bit-for-bit", state: Bound(file: "crates/forge-sim/tests/test_replay.rs", control: "positive_control_a_frame_rate_dependent_step_fails_replay")),
