        (id: "C-split-editor-viewport-stream", name: "thin-client-viewport-encode-transit-decode-within-budget-s11", state: Unbuilt(reason: "M2-16 streams commands and state deltas and the viewport renders locally from the mirror; hardware viewport encode (NVENC / VA-API / AMF, AV1 or H.264) and its 16 ms budget are Spike S11 (M5), not built")),
        (id: "C-split-editor-webrtc", name: "split-editor-over-a-webrtc-data-channel-for-nat-traversal", state: Unbuilt(reason: "M2-16 is QUIC on a LAN (Ch.34 section 34.3); the WebRTC data channel for NAT traversal, and pointing it at the user's own TURN server, are not built")),
        (id: "C-audit-teammates", name: "the-audit-log-carries-every-teammate-envelope-by-sandbox", state: Unbuilt(reason: "D-4: the real teammate stream needs forge-collab / forge-server (M5-18, M6-10). On the labelled in-memory team server (WP-U10, ADR 0039) the core writes every pulled teammate revision (origin teammate, the pulling sandbox) and every team, claim, publish and review command (origin team, sandbox-tagged) to the audit book; the audit panel's footer still names the real stream UNBUILT")),
        (id: "C-team-roles-per-command", name: "team-roles-are-checked-per-command-and-team-commands-are-human-only-and-audited", state: Bound(file: "crates/forge-editor/tests/test_team_collab.rs", control: "positive_control_an_unguarded_core_ignores_roles")),
